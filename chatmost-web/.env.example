# Optional Convex backend deployment URL (e.g. https://your-deployment.convex.cloud)
# If left empty or unset, the app runs 100% locally from the precompiled 236-day archive dataset.
VITE_CONVEX_URL=

# Default Twitch channel for live anonymous chat and audience voting (default: jo2uke)
VITE_TWITCH_CHANNEL=jo2uke
