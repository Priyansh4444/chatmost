{
  "name": "chatmost-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:worker": "wrangler dev",
    "build": "vite build --config web/vite.config.ts",
    "deploy": "vite build --config web/vite.config.ts && wrangler deploy",
    "lint": "eslint web/src",
    "typecheck": "tsc --noEmit -p web",
    "test": "vitest run --config web/vitest.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "knip": "^6.32.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "dependencies": {
    "@fontsource/iosevka": "^5.3.0",
    "@tanstack/react-query": "^5.101.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "effect": "3.22.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.0"
  },
  "knip": {
    "ignore": [
      "web/postcss.config.js",
      "web/tailwind.config.js"
    ],
    "ignoreDependencies": [
      "autoprefixer",
      "postcss",
      "react-compiler-runtime",
      "tailwindcss"
    ]
  },
  "overrides": {
    "zod-validation-error": "4.0.2"
  }
}
