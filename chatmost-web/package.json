{
  "name": "chatmost-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:convex": "convex dev",
    "seed:convex": "convex run seed:seedBatch",
    "dev:worker": "wrangler dev",
    "build": "vite build --config web/vite.config.ts",
    "deploy": "vite build --config web/vite.config.ts && wrangler deploy",
    "db:local": "wrangler d1 execute chatmost --local --file=../chatmost/chatmost-d1.sql",
    "lint": "eslint web/src",
    "typecheck": "tsc --noEmit -p web"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.1.0",
    "@eslint/js": "^9.39.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "wrangler": "^3.100.0",
    "zod-validation-error": "^5.0.0"
  },
  "dependencies": {
    "babel-plugin-react-compiler": "^1.0.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^1.1.1",
    "convex": "^1.44.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "^18.3.1",
    "react-scan": "^0.5.7",
    "tailwind-merge": "^2.5.0"
  }
}
